# Copy to .env and fill in. The .env file is gitignored.

# Backend configuration
DATABASE_URL=sqlite:///./dealmesh.db
DEAL_SIGNING_SECRET=replace-with-a-long-random-secret
DEAL_EXPIRY_MINUTES=15

# Live proposal engine. Leave LLM_PROVIDER unset so the app auto-detects whichever key is present;
# pasting GROQ_API_KEY alone is enough to switch on live negotiation.
# Free hosted option - https://console.groq.com -> API Keys -> Create API Key (no card required):
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.8
LLM_TIMEOUT_SECONDS=20
# Fully local option instead:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# Force the offline rules engine, ignoring any key above:
# LLM_PROVIDER=deterministic

# Razorpay test mode
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Frontend configuration
# VITE_API_URL=http://127.0.0.1:8000
