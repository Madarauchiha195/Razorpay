# Copy to .env and fill in. The .env file is gitignored.

DATABASE_URL=sqlite:///./dealmesh.db
DEAL_SIGNING_SECRET=replace-with-a-long-random-secret
DEAL_EXPIRY_MINUTES=15

# Live proposal engine. Leave LLM_PROVIDER unset: the app auto-detects whichever key is present,
# so pasting GROQ_API_KEY is enough to switch on live negotiation. Setting LLM_PROVIDER explicitly
# overrides that detection, and "deterministic" keeps the offline engine even with a valid key.
#
# Free hosted option - https://console.groq.com -> API Keys -> Create API Key (no card required):
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.8
LLM_TIMEOUT_SECONDS=20
#
# Fully local option - needs `ollama serve` and `ollama pull qwen2.5:7b`:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
#
# Force the offline rules engine, ignoring any key above:
# LLM_PROVIDER=deterministic

# Razorpay test mode. Without these, payment creation returns a simulated order.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
